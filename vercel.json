    { "src": "^/login$", "status": 308, "headers": { "Location": "/login/" } },
    { "src": "^/login/$", "dest": "/login/login.html" },

    { "src": "^/signup$", "status": 308, "headers": { "Location": "/signup/" } },
    { "src": "^/signup/$", "dest": "/signup/signup.html" },

    { "src": "^/dashboard$", "status": 308, "headers": { "Location": "/dashboard/" } },
