    { "src": "^/academy/$", "dest": "/academy/academy.html" },

    { "src": "^/business$", "status": 308, "headers": { "Location": "/business/" } },
    { "src": "^/business/$", "dest": "/business/business.html" },

    { "src": "^/career$", "status": 308, "headers": { "Location": "/career/" } },
    { "src": "^/career/$", "dest": "/career/career.html" },

    { "src": "^/contact$", "status": 308, "headers": { "Location": "/contact/" } },
